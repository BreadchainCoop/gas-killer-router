# =============================================================================
# AVS Router Configuration
# =============================================================================

# This configuraiton file is used by the E2E test CI/CD workflows

# =============================================================================
# Rust Configuration
# =============================================================================
RUST_LOG=info

# =============================================================================
# Network Configuration (Sepolia - Primary Chain)
# =============================================================================
# For TESTNET mode (Sepolia)
# HTTP_RPC=https://ethereum-sepolia-rpc.publicnode.com # Change to private rpc
# WS_RPC=wss://ethereum-sepolia-rpc.publicnode.com # Change to private websocket

# For LOCAL mode
HTTP_RPC=http://localhost:8545
WS_RPC=ws://localhost:8545
FORK_URL=https://ethereum-sepolia-rpc.publicnode.com

# =============================================================================
# Network Configuration (L2 - Optional)
# =============================================================================
# Uncomment to enable L2 chain support
# For TESTNET mode (L2)
# L2_HTTP_RPC=https://rpc.gnosischain.com
# L2_WS_RPC=wss://rpc.gnosischain.com/wss

# =============================================================================
# Router Configuration
# =============================================================================
# Quorum number to use (default: 0)
# QUORUM_NUMBER=0

# Max seconds the executor waits for a verifyAndUpdate transaction receipt before
# timing out the round and proceeding to the next one. Prevents an indefinite
# stall under L1 mempool congestion or RPC degradation. Applies to all chains;
# leave unset to use the per-chain defaults (L1: 120s, L2: 30s).
# EXECUTOR_RECEIPT_TIMEOUT_SECS=120

# Max seconds the router waits for a certificate on its assigned height before it
# switches from broadcasting Announce to broadcasting Skip for that height (accepts
# fractional seconds; default: 30). The engine certifies as soon as quorum signs, so
# this is a recovery window for stalled heights, not a throttle. Every height must
# still certify (with the task digest or the skip digest) before the next task is
# assigned — the timeout bounds how long a stalled task blocks the queue, it does
# not abandon the height. Nodes reuse the same value as the retry budget for
# transient validation errors before signing the skip digest, so it must comfortably
# exceed worst-case node compute + sign time. Tune against the
# gas_killer_p2p_round_trip_seconds and round-timeout metrics.
# ROUND_TIMEOUT=300

# How often (in seconds) the router re-sends the TaskDirective for the in-flight
# height — Announce, then Skip after ROUND_TIMEOUT — until the height certifies
# (accepts fractional seconds; default: 5). Also used by the aggregation engine
# (router and nodes) as its internal TipAck rebroadcast timeout. Must stay well
# below ROUND_TIMEOUT: a node that misses every Announce can only skip the height.
# REBROADCAST_INTERVAL=15

# How often (in milliseconds) to poll for a new round between task cycles (default: 2000).
# Only applies when INGRESS=false; when INGRESS=true the creator blocks on an event-driven
# channel and this value has no effect. Must be > 0 to avoid a busy-loop.
# POLLING_INTERVAL_MS=2000

# THRESHOLD (REMOVED): the signature-count override from the old star-topology
# aggregator no longer exists. The quorum is now fixed by the consensus engine at
# n - floor((n-1)/3) of the n registered operators (n=3 -> 3-of-3, n=4 -> 3-of-4);
# the on-chain QUORUM_THRESHOLD stake check still applies at submission.

# =============================================================================
# Aggregation Engine Configuration
# =============================================================================
# STORAGE_DIR: writable directory for the consensus engine's journal (write-ahead
# log of acks/certificates, replayed on restart). docker-compose and Helm mount a
# dedicated volume at /app/data and set this explicitly; when unset the binaries
# fall back to /app/data if writable, else $TMPDIR/gas-killer (bare-metal dev runs
# only — the temp fallback does not survive reboots). Wiping the node journals and
# restarting is the manual recovery for a wedged height (see README
# "Failure modes and recovery").
# STORAGE_DIR=/app/data

# AGG_WINDOW: number of heights the aggregation engine works on concurrently above
# its tip (default: 8). The router assigns one task at a time, so the default has
# ample headroom; zero or unparseable values fall back to the default.
# AGG_WINDOW=8

# AGG_ACTIVITY_TIMEOUT: how many heights below the tip the engine keeps tracking
# (ack collection + prune buffer) before pruning (default: 256). Must be generous:
# heights pruned past this window can never certify locally, so the router would
# miss their certificates.
# AGG_ACTIVITY_TIMEOUT=256

# =============================================================================
# P2P Channel Configuration
# =============================================================================
# P2P_MESSAGE_BACKLOG: depth of the per-channel message queue (default: 256).
# Once full, incoming messages are dropped. Increase if operators or the router
# fall behind under bursts; the cost is memory proportional to message size.
# P2P_MESSAGE_BACKLOG=256
#
# P2P_MESSAGES_PER_SECOND: per-peer rate limit for the task-directive channel
# (channel 1; default: 1.0). Accepts floats — use values < 1.0 for sub-second
# intervals (e.g. 0.5 = one message every two seconds) or > 1.0 for higher
# throughput. This is a smooth rate with no burst allowance: 5.0 means one
# message every 200ms, not bursts of five.
# P2P_MESSAGES_PER_SECOND=1.0
#
# P2P_ACK_MESSAGES_PER_SECOND: per-peer rate for the engine's TipAck channel
# (channel 0). The engine keeps rebroadcasting each signed height's ack every
# REBROADCAST_INTERVAL until it falls AGG_ACTIVITY_TIMEOUT below the tip, and the
# p2p sender SILENTLY DROPS messages beyond the rate — an undersized quota starves
# fresh acks and stalls certification. Default: computed as
# 2 * AGG_ACTIVITY_TIMEOUT / REBROADCAST_INTERVAL + 8 (e.g. 111 with the library
# defaults). Only override to constrain bandwidth, and keep it well above
# AGG_ACTIVITY_TIMEOUT / REBROADCAST_INTERVAL.
# P2P_ACK_MESSAGES_PER_SECOND=111

# =============================================================================
# Signature scheme
# =============================================================================
# SIGNATURE_SCHEME: bls (default) or schnorr. Selects the quorum-signature
# scheme the whole stack runs; every binary in a deployment must agree.
#   - bls: the commonware aggregation engine with BN254-aggregated operator
#     signatures verified on-chain by the BLSSignatureChecker (channel 0).
#   - schnorr: the interactive two-round MuSig2 aggregate protocol (router =
#     coordinator, nodes = participants, on p2p channel 2) producing a single
#     constant-gas signature verified against the SchnorrStakeRegistry. In this
#     mode each node also loads a secp256k1 signing key (--schnorr-key-file); the
#     p2p transport identity stays BN254 in both modes.
# SIGNATURE_SCHEME=bls
#
# SCHNORR_STAGE_TIMEOUT_SECS: per-stage timeout (nonce collection, partial
# collection) for the schnorr coordinator's rounds. Default: min(5, ROUND_TIMEOUT/6)
# so several attempts fit inside one round-timeout window. Schnorr mode only.
# SCHNORR_STAGE_TIMEOUT_SECS=5
#
# P2P_SCHNORR_MESSAGES_PER_SECOND: per-peer rate for the schnorr protocol channel
# (channel 2; default: 64). Sized generously — the p2p sender SILENTLY DROPS
# messages beyond the rate, and a dropped signing-round message costs a whole
# retry attempt. Schnorr mode only.
# P2P_SCHNORR_MESSAGES_PER_SECOND=64

# STATE_ENCODING: legacy (default), canonical, or prestate-net. How the off-chain
# executor lays out a task's storage mutations in the update program applied
# on-chain. Must be identical on every node AND the router — it changes
# `storage_updates`, hence the task digest, so a mismatch makes every signature fail
# to verify. Roll changes out atomically; a rolling update that transiently mixes
# encodings fails quorum until it converges.
#   legacy    — raw depth-1 SSTOREs in trace order; nested writes replay natively
#               inside their emitted CALL. No guarantee about the storage an
#               external (re-entrant) call observes mid-program.
#   canonical — before every external CALL/CREATE, a slice brings the target's
#               storage to the exact image native execution had at that point (so a
#               re-entrant call into the Gas Killer target reads canonical state),
#               plus a final slice re-asserting the canonical end state. Same
#               on-chain primitives (StateChangeHandlerLib), no contract change.
#               Enable for targets whose tasks make re-entrant external calls.
#   prestate-net — the target's NET storage diff: one slot-sorted store per changed
#               slot, plus its logs, read from the prestateTracer/callTracer pair
#               rather than a struct-log trace. Costs O(changed slots) instead of
#               O(execution steps), which is what makes heavy-compute tracked
#               functions extractable at all — their struct-log trace is large enough
#               to time out or exhaust the node. Repeated writes to one slot collapse
#               to a single store and a slot written back to its original value
#               produces none, so it is deliberately byte-different from the other
#               two for the same call. Calls it cannot represent (an external CALL,
#               CREATE, or SELFDESTRUCT at target depth) fall back to the CANONICAL
#               encoder, not legacy.
#
#               REQUIRES every node's and the router's RPC to support debug_traceCall
#               with prestateTracer (diffMode) and callTracer (withLog). A node whose
#               RPC lacks either FAILS THE TASK rather than quietly downgrading —
#               silently switching representation would sign a digest no other
#               operator can match, turning a node-config difference into a consensus
#               split. Anvil supports both; hosted providers often gate prestateTracer
#               to paid tiers, so confirm before enabling off a local fork.
#
#               Tracer support is necessary but NOT sufficient on a mixed fleet: the
#               clients must also agree on tracer OUTPUT. Log ordering is taken from
#               callTracer's global `index` when every log carries one and from
#               `position` otherwise, and `index` is not universally populated (geth
#               populates `position`). Two operators on different clients can both
#               support the tracers and still order logs differently — same end state,
#               different bytes, forked digest. Until gas-analyzer#178 settles on one
#               source and fails closed when it is absent, treat prestate-net as
#               proven only on a single-client fleet (the all-anvil local stack), not
#               a heterogeneous geth/reth/hosted deployment.
#
#               Observability: the extraction path is recorded as an `extraction`
#               field (prestate_net | struct_log) on the evmsketch.encode tracing
#               span, so a fleet split across representations is detectable. It is a
#               span field rather than an event, so it needs span logging enabled to
#               surface — it will not appear at plain RUST_LOG=info.
# STATE_ENCODING=legacy

# GK_SIM_PROFILE: chain (default) or unbounded. The EVM environment a tracked
# function is SIMULATED under. Independent of STATE_ENCODING, which selects how the
# resulting mutations are represented; this selects the gas limits the simulation runs
# with. Like STATE_ENCODING it must be identical on every node AND the router — it
# changes the derived `storage_updates`, hence the task digest, so a mismatch makes
# every signature fail to verify. An unrecognized value PANICS at startup rather than
# defaulting: a typo that quietly fell back to `chain` on one node would fork the quorum.
#   chain        — simulate under the target chain's real gas limits.
#   unbounded — simulate under the pinned unbounded gas limits (gas-analyzer
#                  docs/UNBOUNDED_MODE.md), so a tracked function whose DIRECT execution
#                  costs more than a block's gas limit can still be analyzed. The payload
#                  it produces is still bounded: applying it on-chain must fit the
#                  profile's budget and contain no CREATE, or the analysis hard-errors —
#                  signing a payload nobody can mine produces an unsettleable task.
#                  The gas estimate for applying the payload stays on the real chain's
#                  limits, because verifyAndUpdate lands in a real block.
#
#                  REQUIRES the RPC serving debug_traceCall to have its execution cap
#                  lifted (`anvil --disable-block-gas-limit` via ANVIL_EXTRA_ARGS below,
#                  or `geth --rpc.gascap=0`). Without it the heavy call OOGs inside the
#                  tracer and extraction fails.
#
#                  Pair it with STATE_ENCODING=prestate-net. The struct-log encodings
#                  cost O(execution steps), which is exactly what an above-block-limit
#                  call makes unaffordable.
#
#                  NOT READY FOR A PRODUCTION FLEET. Three preconditions are open, tracked
#                  in gas-killer/service#356: (1) the SP1 fraud-proof guest must bind the
#                  same lifted limits (sp1-contract-call#12) — a guest checking against real
#                  header limits while operators simulate under lifted ones would judge an
#                  honest payload invalid, i.e. false slashing; (2) the payload gate's
#                  per-byte dispatch constant needs re-measuring against a real
#                  verifyAndUpdate (gas-analyzer#166); (3) every operator's debug_traceCall
#                  RPC needs its execution cap lifted. Because the profile changes the task
#                  digest, enabling it is a coordinated fleet-wide flip, not a rolling one.
# GK_SIM_PROFILE=chain

# ANVIL_EXTRA_ARGS: extra flags appended to the local anvil command (the compose
# `ethereum` service). Empty by default. GK_SIM_PROFILE=unbounded needs
# `--disable-block-gas-limit` here so anvil will execute a call above the block limit.
# ANVIL_EXTRA_ARGS=--disable-block-gas-limit

# =============================================================================
# AVS Service Manager Wrapper Configuration
# =============================================================================
# These values are passed as immutable constructor parameters when deploying
# AvsServiceManagerWrapper and CANNOT be changed after deployment.
#
# QUORUM_THRESHOLD / THRESHOLD_DENOMINATOR: fraction of total registered
# operator stake that must sign a task for it to be accepted. 2/3 means at
# least two-thirds of stake-weighted operators must co-sign. In schnorr mode
# (see SIGNATURE_SCHEME) these same values additionally set the router
# coordinator's local participation floor and the SchnorrStakeRegistry's
# on-chain threshold, keeping the off-chain and on-chain checks in lockstep.
#
# BLOCK_STALE_MEASURE: maximum age (in blocks) of a valid reference block.
# At ~12 s/block on Ethereum, 300 blocks ≈ 1 hour. The service also reuses this as an
# off-chain policy bound: ingress rejects requests whose block_height is older than this,
# and the speculative executor cache is sized to cover this window.
#
# SCHNORR_NOTICE_WINDOW: blocks a SchnorrStakeRegistry operator-set change must be
# announced ahead of taking effect (schnorr mode only; see SIGNATURE_SCHEME). Announcing
# publishes a horizon via nextPossibleMutationBlock(); the router reads it when rendering a
# payload and ends that payload's validity before it, so a settlement is never assembled
# against one operator set and verified against another.
# Defaults to 0, which applies changes as soon as they are committed — correct for this
# stack, where the whole operator set is registered before the target contract deploys and
# no round is ever in flight for a mutation to invalidate.
#
# The horizon only covers announced changes. registerOperator / deregisterOperator bypass
# the window for bootstrap and emergencies and emit ForcedMutation; a forced change can
# still invalidate a payload the router already handed out.
#
# A deployment that changes its operator set while rounds are in flight must set this
# above the signing round's duration plus BLOCK_STALE_MEASURE, since a rendered payload
# stays submittable for that long. The registry cannot enforce the relationship: the
# staleness bound lives on each consumer contract and is adjustable there, while one
# registry may back several consumers.
QUORUM_THRESHOLD=2
THRESHOLD_DENOMINATOR=3
BLOCK_STALE_MEASURE=300
# SCHNORR_NOTICE_WINDOW=0

# PAYLOAD_BLOCK_BUFFER: blocks past the aggregation reference block for which a completed task's
# rendered, user-signable payload stays valid (its valid_until_block). Past this, GET /tasks/{id}
# returns a PAYLOAD_EXPIRED re-request error instead of calldata that would revert on-chain. A
# payload is only submittable while referenceBlockNumber + BLOCK_STALE_MEASURE >= block.number, so
# values above BLOCK_STALE_MEASURE are clamped to it. Default: 50.
#
# In schnorr mode this is an upper bound rather than the final value: a payload's validity is also
# clamped to end before the registry's next possible operator-set change (see
# SCHNORR_NOTICE_WINDOW), so it can expire sooner than this buffer allows.
# PAYLOAD_BLOCK_BUFFER=50
#
# INGRESS_STALENESS_WINDOW_BLOCKS: how far behind the target chain's head a submitted block_height
# may be and still be admitted. Past it, POST /tasks returns 400 STALE_BLOCK naming the window.
# A task's analysis is anchored at its block_height, and the aggregation round plus the rendered
# payload's own validity window both have to fit in what remains of BLOCK_STALE_MEASURE — so
# admission holds PAYLOAD_BLOCK_BUFFER blocks back rather than accepting work that can only just
# finish simulating. Unset, it derives BLOCK_STALE_MEASURE - PAYLOAD_BLOCK_BUFFER (250 at the stock
# 300/50), floored at 1 block; an explicit value past BLOCK_STALE_MEASURE is clamped to it, since
# an analysis older than the operator-set window cannot yield a submittable payload and also misses
# the speculative executor cache. Set to 0 to disable the check entirely (escape hatch — the router
# will then accept arbitrarily old anchors). Default: derived.
# INGRESS_STALENESS_WINDOW_BLOCKS=250
#
# The GET /tasks/{id} block-window freshness check measures valid_until_block against the L1 chain
# (HTTP_RPC), where the operator-set reference block lives. An L2-only deployment (no HTTP_RPC)
# skips that check and relies on the target's stateTransitionCount plus the on-chain staleness
# revert; configure an L1 provider so a stale payload is caught as a 409 before submission.

# Speculative executor pre-build: the node/router watch each chain's head and pre-build the
# EVMSketch executor for the latest block so a task's first validation hits the cache instead
# of paying the ~80-120 ms build() on the critical path. The cached executor only feeds the
# (discarded) gas estimate, never the signed storage_updates, so building at the tip is safe.
# SPECULATIVE_PREBUILD: set to false/0/no to disable the loop (default: true)
# SPECULATIVE_PREBUILD_POLL_MS: head-poll interval in milliseconds (default: 2000)
# SPECULATIVE_PREBUILD_CONFIRMATIONS: blocks behind head to target (default: 0 = tip)
SPECULATIVE_PREBUILD=true
SPECULATIVE_PREBUILD_POLL_MS=2000
SPECULATIVE_PREBUILD_CONFIRMATIONS=0

